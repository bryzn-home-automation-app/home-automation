# WiFi tab — guest network credentials displayed on the /wifi page.
#
# DEV ONLY: Vite reads this file when running `npm run dev` locally.
#   Copy to `frontend/.env` (gitignored) and set your values.
#
# PRODUCTION (Docker/nginx): this file is NOT used and is not shipped (gitignored).
#   Set VITE_WIFI_SSID / VITE_WIFI_PASSWORD in the repo-root `.env` instead —
#   docker-compose passes them as build args to the nginx image (see nginx/Dockerfile).
#
# Note: Vite inlines these at build time and ships them to the browser, so they
# are NOT secret from the app's users — this only keeps the real password out of
# source control. Any authenticated user can already read whatever is shown here.
VITE_WIFI_SSID=HomeAutomation
VITE_WIFI_PASSWORD=change-me

# PostgreSQL
POSTGRES_DB=homeplatform
POSTGRES_USER=homeplatform
POSTGRES_PASSWORD=change-me-in-production

# Redis
REDIS_PASSWORD=

# Backend
JWT_SECRET=change-me-to-a-random-string
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=5173

# WiFi tab — guest network credentials shown on the /wifi page.
# Baked into the frontend at Docker build time (nginx service build args).
VITE_WIFI_SSID=
VITE_WIFI_PASSWORD=

# Nginx
NGINX_PORT=80

# CoServ SmartHub Integration (Green Button Download)
COSERV_USERNAME=
COSERV_PASSWORD=
COSERV_PORTAL_URL=https://coserv.smarthub.coop/ui/#/login

# Data backfill — sync all usage from this date forward
# Set once (e.g. house purchase date), never change
DATA_START_DATE=07/24/2026

# CoServ electric rate ($/kWh) — used for bill estimation
KWH_RATE=0.12

# Property coordinates for weather integration (Open-Meteo)
PROPERTY_LATITUDE=
PROPERTY_LONGITUDE=

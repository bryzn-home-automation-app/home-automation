# PostgreSQL
POSTGRES_DB=homeplatform
POSTGRES_USER=homeplatform
POSTGRES_PASSWORD=change-me-in-production

# Redis
REDIS_PASSWORD=

# Backend
# REQUIRED — signing key for JWTs. Must be >= 32 characters. The backend
# refuses to start without it. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string
BACKEND_PORT=8080

# REQUIRED (only when seeding a fresh admin) — password for the seeded admin
# account. No default is committed, so the app fails fast if this is unset and
# the admin user doesn't exist yet.
ADMIN_EMAIL=bryznnguyen@gmail.com
ADMIN_USERNAME=bryzncode
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Bryan

# Shared code required for guest check-in (/guest). Blank = guest login disabled.
GUEST_INVITE_CODE=

# Swagger / API docs — off by default in production. Set "true" to enable.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# Login brute-force protection (Redis-backed, per-IP fixed window)
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Frontend
FRONTEND_PORT=5173

# WiFi tab — guest network credentials shown on the /wifi page.
# Baked into the frontend at Docker build time (nginx service build args).
VITE_WIFI_SSID=
VITE_WIFI_PASSWORD=

# Nginx
NGINX_PORT=80

# CoServ SmartHub Integration (Green Button Download)
COSERV_USERNAME=
COSERV_PASSWORD=
COSERV_PORTAL_URL=https://coserv.smarthub.coop/ui/#/login

# Data backfill — sync all usage from this date forward
# Set once (e.g. house purchase date), never change
DATA_START_DATE=07/24/2026

# CoServ electric rate ($/kWh) — used for bill estimation
KWH_RATE=0.12

# CoServ gas rate ($/unit) — gas usage is metered in CCF-equivalent "units", not kWh
GAS_UNIT_RATE=1.47

# Property coordinates for weather integration (Open-Meteo)
PROPERTY_LATITUDE=
PROPERTY_LONGITUDE=

# Gmail water bill sync (scripts/sync-water-bill.js) — read-only Gmail API access
# to fetch the monthly water bill PDF forwarded to a "Water Bill" Gmail label.
# GMAIL_CLIENT_ID/SECRET come from a Google Cloud OAuth Desktop client.
# GMAIL_REFRESH_TOKEN is obtained once by running scripts/gmail-authorize.js.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Gmail label containing forwarded water bill emails.
GMAIL_WATER_BILL_LABEL=Water Bill
# City of Lewisville water account (from the bill's ACCOUNT field). Never commit real values.
WATER_ACCOUNT_NUMBER=
WATER_SERVICE_ADDRESS=

# Roomba poller (roomba-poller service) — iRobot Home app cloud credentials.
# The poller is the ONLY component that holds these. Never commit real values.
IROBOT_EMAIL=
IROBOT_PASSWORD=
IROBOT_COUNTRY=US
# Optional — pin a specific robot by BLID (32-hex). Blank = auto-select.
IROBOT_ROBOT_BLID=
# Poll cadence in seconds (min 5).
POLL_INTERVAL_SECONDS=60

# Home Assistant (ecobee thermostat, Eufy cameras) — see docs/home-assistant-integration.md.
# The backend is the ONLY component that holds the token; it is never sent to the browser.
# The integration stays off unless HA_ENABLED=true AND HA_TOKEN is set.
HA_ENABLED=false
# Leave blank to use the bundled homeassistant service (compose defaults it to
# http://homeassistant:8123). Set it only if HA runs somewhere else.
HA_URL=
# Long-lived access token (HA → Profile → Security). Never commit real values.
HA_TOKEN=

# Eufy cameras / HomeBase (eufy-sdk bridge) — see docs/home-assistant-integration.md.
# Use a DEDICATED Eufy account with the HomeBase shared to it (admin): Eufy allows
# one active login per account, so the bridge would sign the phone app out.
# The bridge only runs when this profile is enabled; leave it commented until the
# account exists. First login may need a 2FA code/captcha, entered in HA when
# adding the eufy-sdk integration (host: eufy-bridge, port: 3000).
#COMPOSE_PROFILES=eufy
EUFY_EMAIL=
EUFY_PASSWORD=
# Country of the Eufy account (two-letter code, e.g. US).
EUFY_COUNTRY=US
